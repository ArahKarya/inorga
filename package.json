{
  "name": "inorga",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:apk": "INORGA_TARGET=apk next build",
    "apk:sync": "pnpm build:apk && npx cap sync android",
    "apk:build": "pnpm apk:sync && cd android && ./gradlew assembleDebug",
    "apk:pasang": "pnpm apk:build && $HOME/Library/Android/sdk/platform-tools/adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "^16.3.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
